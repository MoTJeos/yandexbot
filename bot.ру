@dp.message(Command("activate_sub"))
async def activate_h(message: types.Message):
    if message.from_user.id != ADMIN_ID:
        await message.answer("❌ Нет прав")
        return
    parts = message.text.split()
    if len(parts) != 2 or not parts[1].isdigit():
        await message.answer("⚠️ /activate_sub ID_пользователя")
        return
    uid = int(parts[1])
    if not cursor.execute("SELECT 1 FROM users WHERE user_id = ?", (uid,)).fetchone():
        await message.answer("❌ Пользователь не найден")
        return
    activate_subscription(uid)
    exp = datetime.fromisoformat(cursor.execute("SELECT subscription_active_until FROM users WHERE user_id = ?", (uid,)).fetchone()[0]).strftime("%d.%m.%Y")
    try:
        await bot.send_message(uid, f"✅ Оплата подтверждена!\n💎 Подписка до {exp}")
    except:
        pass
    await message.answer(f"✅ Подписка для {uid} до {exp}")

