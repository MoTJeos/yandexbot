@dp.message(StateFilter(Broadcast.waiting_for_content))
async def ad_send(message: types.Message, state: FSMContext):
    await state.clear()
    uids = [r[0] for r in cursor.execute("SELECT user_id FROM users").fetchall()]
    if ADMIN_ID not in uids:
        uids.append(ADMIN_ID)
    ok = 0
    for uid in uids:
        try:
            if message.photo:
                await bot.send_photo(uid, message.photo[-1].file_id, caption=message.caption)
            elif message.video:
                await bot.send_video(uid, message.video.file_id, caption=message.caption)
            elif message.document:
                await bot.send_document(uid, message.document.file_id, caption=message.caption)
            else:
                await bot.send_message(uid, message.text)
            ok += 1
            await asyncio.sleep(0.05)
        except:
            pass
    await message.answer(f"✅ Разослано: {ok} из {len(uids)}")

@dp.message(StateFilter(None), lambda m: not m.text.startswith("/"))
async def talk(message: types.Message):
    uid = message.from_user.id
    if not (await check_subscription(uid))["is_subscribed"]:
        await message.answer(f"🔒 Подпишись: {CHANNEL_LINK}")
        return
    cnt, _, sub_until = get_user_data(uid)
    if not has_active_subscription(sub_until) and cnt >= FREE_DAILY_LIMIT:
        await message.answer(f"⚠️ Лимит {FREE_DAILY_LIMIT} запросов исчерпан\n💎 /subscribe для безлимита")
        return
    if uid not in user_history:
        user_history[uid] = []
    if message.text.lower() in GREETINGS:
        await message.answer("👋 Привет! Чем могу помочь?")
        return
    user_history[uid].append({"role": "user", "text": message.text})
    if len(user_history[uid]) > MAX_HISTORY_LENGTH:
        user_history[uid] = user_history[uid][-MAX_HISTORY_LENGTH:]
    msgs = [{"role": "system", "text": "Отвечай понятно, структурированно, учитывай историю диалога."}] + user_history[uid]
    try:
        await bot.send_chat_action(message.chat.id, "typing")
        ans = await get_ai_answer(msgs)
        user_history[uid].append({"role": "assistant", "text": ans})
        if not has_active_subscription(sub_until):
            increment_request_count(uid)
        await message.answer(ans, parse_mode="Markdown")
    except Exception as e:
        await message.answer(f"⚠️ Ошибка: {e}")

