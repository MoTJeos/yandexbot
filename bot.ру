class Broadcast(StatesGroup):
    waiting_for_content = State()

conn = sqlite3.connect("users.db")
cursor = conn.cursor()
cursor.execute("""
CREATE TABLE IF NOT EXISTS users (
    user_id INTEGER PRIMARY KEY UNIQUE,
    username TEXT,
    first_name TEXT,
    request_count INTEGER DEFAULT 0,
    last_request_date TEXT DEFAULT '',
    subscription_active_until TEXT DEFAULT '',
    last_payment_label TEXT DEFAULT ''
)
""")
conn.commit()

def get_user_data(user_id: int):
    row = cursor.execute(
        "SELECT request_count, last_request_date, subscription_active_until FROM users WHERE user_id = ?",
        (user_id,)
    ).fetchone()
    if not row:
        return 0, "", ""
    count, last_date, sub_until = row
    today = datetime.now().date().isoformat()
    if last_date != today:
        cursor.execute(
            "UPDATE users SET request_count = 0, last_request_date = ? WHERE user_id = ?",
            (today, user_id)
        )
        conn.commit()
        count = 0
    return count, today, sub_until

def has_active_subscription(sub_until: str) -> bool:
    if not sub_until:
        return False
    try:
        return datetime.now().date() <= datetime.fromisoformat(sub_until).date()
    except:
        return False

def increment_request_count(user_id: int):
    today = datetime.now().date().isoformat()
    cursor.execute(
        "UPDATE users SET request_count = request_count + 1, last_request_date = ? WHERE user_id = ?",
        (today, user_id)
    )
    conn.commit()

def activate_subscription(user_id: int):
    new_expiry = (datetime.now() + timedelta(days=SUBSCRIPTION_DAYS)).isoformat()
    cursor.execute(
        "UPDATE users SET subscription_active_until = ?, last_payment_label = '' WHERE user_id = ?",
        (new_expiry, user_id)
    )
    conn.commit()

def save_payment_label(user_id: int, label: str):
    cursor.execute(
        "UPDATE users SET last_payment_label = ? WHERE user_id = ?",
        (label, user_id)
    )
    conn.commit()

async def check_subscription(user_id: int) -> dict:
    try:
        ch = await bot.get_chat(CHANNEL["id"])
        member = await bot.get_chat_member(ch.id, user_id)
        return {"ok": True, "is_subscribed": member.status not in ("left", "kicked"), "link": CHANNEL["link"]}
    except Exception as e:
        return {"ok": False, "error": str(e)}

def save_user(user_id: int, username: str, first_name: str):
    cursor.execute(
        "INSERT OR IGNORE INTO users (user_id, username, first_name, request_count, last_request_date, subscription_active_until) "
        "VALUES (?, ?, ?, 0, ?, '')",
        (user_id, username or "", first_name, datetime.now().date().isoformat())
    )
    conn.commit()

# Новая функция запроса — через OpenAI клиент
async def get_ai_answer(messages: list) -> str:
    openai_messages = []
    for msg in messages:
        openai_messages.append({"role": msg["role"], "content": msg["text"]})
    
    response = client.chat.completions.create(
        model=MODEL_NAME,
        messages=openai_messages,
        temperature=0.8,
        max_tokens=2048
    )
    return response.choices[0].message.content.strip()

def generate_payment_link(user_id: int) -> tuple[str, str]:
    label = f"sub_{user_id}_{int(datetime.now().timestamp())}"
    link = f"https://yoomoney.ru/quickpay/confirm.xml?receiver={YOOMONEY_WALLET}&quickpay-form=button&paymentType=AC&sum={SUBSCRIPTION_PRICE}&label={label}"
    return link, label

